# ===== Rollar kesimida tahlil (Google Sheets) =====
# Varaq ustunlari: Ariza raqami | Tuman | Manba | Rol | Kun  (jamlanma serverda hisoblanadi)
DEADLINE_SHEET_ID=
DEADLINE_SHEET_NAME=Arizalar

# ===== To'lov kutilmoqda (Google Sheets) =====
PAYMENT_SHEET_ID=
PAYMENT_SHEET_MAIN=TolovKutilmoqda
PAYMENT_SHEET_PLAN=TolovReja

# ===== Kadastr maslahat burchagi (Google Sheets + Apps Script) =====
ADVICE_SHEET_ID=
ADVICE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# ===== Saytga kirish (Users / Logs sheet + apps-script/auth/Code.gs) =====
AUTH_APPS_SCRIPT_URL=https://script.google.com/macros/s/YYYYYYYY/exec
# Apps Script → Project Settings → Script Properties → API_SECRET bilan bir xil bo'lsin
AUTH_APPS_SCRIPT_SECRET=
# Sayt sessiyasi muddati (soat)
AUTH_SESSION_HOURS=12

# Sessiya cookie imzosi uchun tasodifiy uzun satr: openssl rand -base64 48
SESSION_SECRET=

# Kirishda joylashuvning ruxsat etilgan eng katta xatoligi (metr). Default 50.
NEXT_PUBLIC_GEO_MAX_ACCURACY_M=50

# Server keshi (ms). "Yangilash" tugmasi keshni chetlab o'tadi.
CACHE_TTL_MS=30000
