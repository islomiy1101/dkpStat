# Local development only. Configure production values in Netlify environment variables.
# Keep credentials and private identifiers out of this template.

# Rollar kesimida tahlil (Google Sheets, "havola orqali ko'rish"): YakunlanganArizalar va JarayondagiArizalar varaqlari
DEADLINE_SHEET_ID=
# Server keshi (ms) — varaqlar katta va faqat "Bazaga yuklash"da o'zgaradi (standart 10 daqiqa)
DEADLINE_CACHE_TTL_MS=600000

# E'tirof (4 ta Google Sheet, "havola orqali ko'rish"): har birida SVOD va xom ro'yxat varag'i
ETIROF_NOMZOD_SHEET_ID=
ETIROF_TAHRIRLASH_SHEET_ID=
ETIROF_TOLOV_SHEET_ID=
ETIROF_QAROR_SHEET_ID=
# Server keshi (ms), standart 5 daqiqa
ETIROF_CACHE_TTL_MS=300000

# Xatlov+Faol (ЎРҚ-937 ШТАБ): "ШТАБ маълумоти" va "Кунлик" varaqlari, "havola orqali ko'rish"
XATLOV_FAOL_SHEET_ID=
XATLOV_CACHE_TTL_MS=300000

# To'lov va tushumlar (Google Sheets)
PAYMENT_SHEET_ID=
PAYMENT_SHEET_MAIN=TolovKutilmoqda
PAYMENT_SHEET_PLAN=TolovReja

# Maslahat burchagi (Google Sheets + Apps Script)
ADVICE_SHEET_ID=
ADVICE_APPS_SCRIPT_URL=

# Filial qabulxonasi (apps-script/reception/Code.gs); secret = Script Properties → API_SECRET
RECEPTION_APPS_SCRIPT_URL=
RECEPTION_APPS_SCRIPT_SECRET=

# Saytga kirish (Users / Logs sheet + apps-script/auth/Code.gs); secret = Script Properties → API_SECRET
AUTH_APPS_SCRIPT_URL=
AUTH_APPS_SCRIPT_SECRET=
AUTH_SESSION_HOURS=12

# Sessiya cookie imzosi: openssl rand -base64 48
SESSION_SECRET=

# Server keshi (ms). "Yangilash" tugmasi keshni chetlab o'tadi.
CACHE_TTL_MS=30000
MOCK_DATA=0

# Ixtiyoriy: faqat "Bazaga yuklash" sahifasidagi havolalar uchun. AUTH_SHEET_ID bo'sh bo'lsa — auth Apps Script'dan olinadi
AUTH_SHEET_ID=
REGTEST_SHEET_ID=
RECEPTION_SHEET_ID=
